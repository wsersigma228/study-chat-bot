# Offline defaults. Copy to .env and configure your own PostgreSQL database.
# This password is a placeholder, not a deployed credential.
DATABASE_URL=postgresql+asyncpg://study_bot:change_me@127.0.0.1:5432/study_bot
POSTGRES_PASSWORD=
STUDY_TIMEZONE=UTC

# Leave Telegram settings blank for the offline demonstration.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=private/telegram.session
TELEGRAM_ACCOUNT_USER_ID=
SOURCE_CHAT_ID=
SCHEDULE_PUBLISHER_USER_ID=
# At least three distinct positive message IDs from a privately reviewed export.
SCHEDULE_PUBLISHER_MESSAGE_IDS=
EXPORT_FINGERPRINT_PATH=private/export/export_fingerprint.json
BOT_TOKEN=
BOT_OWNER_USER_ID=
# Command groups only; never copy SOURCE_CHAT_ID here.
BOT_ALLOWED_CHAT_IDS=
# Optional publication destination, distinct from source and command groups.
BOT_CHANNEL_ID=
MEDIA_ROOT=private/media
MEDIA_MAX_DOWNLOAD_MB=25
RECONCILE_DAYS=7
